{
  "identifier": "add_swarm_to_service",
  "title": "Add swarm to service",
  "allowAnyoneToViewRuns": true,
  "nodes": [
    {
      "identifier": "trigger",
      "title": "Add swarm to service",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "swarm": {
              "title": "Swarm",
              "type": "string",
              "format": "entity",
              "blueprint": "_team"
            },
            "service": {
              "title": "Service",
              "type": "string",
              "format": "entity",
              "blueprint": "__SERVICE_BLUEPRINT__"
            }
          },
          "required": [
            "service",
            "swarm"
          ],
          "order": [
            "service",
            "swarm"
          ]
        },
        "published": true,
        "permissions": {
          "roles": [
            "Admin"
          ],
          "teams": []
        }
      }
    },
    {
      "identifier": "set_pending_swarm",
      "title": "Set pending swarm on service",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "__SERVICE_BLUEPRINT__",
        "mapping": {
          "identifier": "{{ .outputs.trigger.service }}",
          "relations": {
            "pending_swarm": "{{ .outputs.trigger.swarm }}"
          }
        },
        "onFailure": "terminate",
        "timeoutMinutes": 60
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "set_pending_swarm"
    }
  ],
  "description": "Stages a swarm on a service. apply_pending_owner then appends it, and its parent team, to the owners."
}
