{
  "identifier": "apply_pending_swarm",
  "title": "Apply pending swarm to user",
  "allowAnyoneToViewRuns": true,
  "nodes": [
    {
      "identifier": "trigger",
      "title": "User has a pending swarm",
      "config": {
        "type": "EVENT_TRIGGER",
        "event": {
          "type": "ENTITY_UPDATED",
          "blueprintIdentifier": "_user"
        },
        "condition": {
          "type": "JQ",
          "expressions": [
            ".diff.after.properties.pending_swarm != null and .diff.after.properties.pending_swarm != \"\""
          ],
          "combinator": "and"
        },
        "published": true
      }
    },
    {
      "identifier": "add_swarm_to_teams",
      "title": "Add swarm to user's teams and clear pending",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "_user",
        "mapping": {
          "identifier": "{{ .outputs.trigger.diff.after.identifier }}",
          "team": "{{ (.outputs.trigger.diff.after.team + [.outputs.trigger.diff.after.properties.pending_swarm]) | unique }}",
          "properties": {
            "pending_swarm": null
          }
        },
        "onFailure": "terminate",
        "timeoutMinutes": 60
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "add_swarm_to_teams"
    }
  ],
  "description": "Appends the staged swarm to the user's teams, keeps their other teams, and clears the staging field."
}
