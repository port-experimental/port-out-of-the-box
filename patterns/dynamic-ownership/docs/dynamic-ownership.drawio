<mxfile host="app.diagrams.net">
  <diagram name="1 How ownership changes" id="p1flow">
    <mxGraphModel dx="2093" dy="982" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;fontStyle=1;" value="How ownership changes dynamically: swarms, workflows and GitHub access" vertex="1">
          <mxGeometry height="30" width="1760" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="d_sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" value="A swarm is a temporary team in Port. Linking it to a service makes its members the GitHub owners of that service&#39;s repo. Nobody edits GitHub or CODEOWNERS by hand; Port is the single place where ownership is changed." vertex="1">
          <mxGeometry height="36" width="1760" x="20" y="44" as="geometry" />
        </mxCell>
        <mxCell id="d_l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7faff;strokeColor=#6c8ebf;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="270" width="1480" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_l1_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3b5f8f;fontStyle=1;" value="1. DATA MODEL (Port)" vertex="1">
          <mxGeometry height="22" width="700" x="30" y="95" as="geometry" />
        </mxCell>
        <mxCell id="d_domain" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Domain team&lt;/b&gt; (_team)&lt;br&gt;Persistent, e.g. Payments" vertex="1">
          <mxGeometry height="52" width="240" x="450" y="122" as="geometry" />
        </mxCell>
        <mxCell id="d_user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;User&lt;/b&gt; (_user)&lt;br&gt;teams: the teams the user belongs to&lt;br&gt;pending_swarm: staging field&lt;br&gt;github_login: the user&#39;s GitHub name" vertex="1">
          <mxGeometry height="130" width="240" x="50" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d_swarm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Swarm&lt;/b&gt; (_team)&lt;br&gt;team_kind = swarm&lt;br&gt;period, status&lt;br&gt;parent_team: exactly 1 domain team" vertex="1">
          <mxGeometry height="130" width="240" x="450" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d_service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;team: owning teams (1 or more)&lt;br&gt;pending_swarm: staging relation&lt;br&gt;pending_swarm_parent: mirror of the swarm&#39;s parent&lt;br&gt;github_repository" vertex="1">
          <mxGeometry height="130" width="280" x="850" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d_repo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;githubTeams: owners-{repo}&lt;br&gt;codeowners: static file" vertex="1">
          <mxGeometry height="130" width="240" x="1240" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d_e_member" edge="1" parent="1" source="d_user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_swarm" value="member of (swarm)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_persist" edge="1" parent="1" source="d_user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="d_domain" value="member of (persistent)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="148" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d_e_owned" edge="1" parent="1" source="d_service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_swarm" value="owned by (1..n)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_repo" edge="1" parent="1" source="d_service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_repo" value="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_parent" edge="1" parent="1" source="d_swarm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_domain" value="parent (1)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fbf5;strokeColor=#82b366;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="240" width="1480" x="20" y="380" as="geometry" />
        </mxCell>
        <mxCell id="d_l2_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#4c7a3a;fontStyle=1;" value="2. WORKFLOWS (Port) and who runs them" vertex="1">
          <mxGeometry height="22" width="700" x="30" y="385" as="geometry" />
        </mxCell>
        <mxCell id="d_w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;1. create_swarm&lt;/b&gt; (form)&lt;br&gt;Input: name, period, parent team&lt;br&gt;Creates the swarm team under its domain team&lt;br&gt;&lt;b&gt;Run by:&lt;/b&gt; Admin, or the requestor teams you choose" vertex="1">
          <mxGeometry height="175" width="300" x="50" y="425" as="geometry" />
        </mxCell>
        <mxCell id="d_w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;2. Add users to the swarm&lt;/b&gt;&lt;br&gt;add_user_to_swarm (form) sets pending_swarm on the user. apply_pending_swarm (event) adds the swarm and keeps their other teams&lt;br&gt;&lt;b&gt;Run by:&lt;/b&gt; Admin, or the requestor teams you choose" vertex="1">
          <mxGeometry height="175" width="300" x="430" y="425" as="geometry" />
        </mxCell>
        <mxCell id="d_w3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;3. add_swarm_to_service&lt;/b&gt; (form)&lt;br&gt;Input: service, swarm&lt;br&gt;Sets the pending_swarm relation on the service. Owners are not changed yet&lt;br&gt;&lt;b&gt;Run by:&lt;/b&gt; Admin, or the requestor teams you choose&lt;br&gt;&lt;b&gt;Approval:&lt;/b&gt; an approval step can be added here" vertex="1">
          <mxGeometry height="175" width="300" x="810" y="425" as="geometry" />
        </mxCell>
        <mxCell id="d_w4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;4. apply_pending_owner&lt;/b&gt; (event)&lt;br&gt;Runs when a service has a pending swarm. New owners = current owners + the swarm + its parent team; then clears the relation&lt;br&gt;&lt;b&gt;Run by:&lt;/b&gt; the system only, no user runs it" vertex="1">
          <mxGeometry height="175" width="290" x="1190" y="425" as="geometry" />
        </mxCell>
        <mxCell id="d_f12" edge="1" parent="1" source="d_w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_w2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_f23" edge="1" parent="1" source="d_w2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_w3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_f34" edge="1" parent="1" source="d_w3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_w4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffaf5;strokeColor=#d79b00;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="215" width="1480" x="20" y="640" as="geometry" />
        </mxCell>
        <mxCell id="d_l3_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#9a6700;fontStyle=1;" value="3. GITHUB (access follows Port)" vertex="1">
          <mxGeometry height="22" width="900" x="30" y="645" as="geometry" />
        </mxCell>
        <mxCell id="d_co" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;CODEOWNERS&lt;/b&gt;&lt;br&gt;* @org/owners-{repo}&lt;br&gt;Never edited. It always points at the same GitHub team&lt;br&gt;&lt;br&gt;&lt;i&gt;Static&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="50" y="690" as="geometry" />
        </mxCell>
        <mxCell id="d_ghteam" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;GitHub team owners-{repo}&lt;/b&gt;&lt;br&gt;Who is in this team decides who can review and push&lt;br&gt;&lt;br&gt;&lt;i&gt;Dynamic: membership follows Port&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="440" y="690" as="geometry" />
        </mxCell>
        <mxCell id="d_sync" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;5. ownership-sync&lt;/b&gt; (GitHub Action)&lt;br&gt;For each service: collect the members of its owning teams, take their github_login, and make owners-{repo} contain exactly those people. Fails if a swarm&#39;s parent team is not an owner&lt;br&gt;&lt;b&gt;Run by:&lt;/b&gt; GitHub Actions on demand. Can also run on a schedule or when owners change" vertex="1">
          <mxGeometry height="140" width="540" x="900" y="690" as="geometry" />
        </mxCell>
        <mxCell id="d_e_co" edge="1" parent="1" source="d_co" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_ghteam" value="points at">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_sync" edge="1" parent="1" source="d_sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_ghteam" value="adds / removes members">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_trig" edge="1" parent="1" source="d_w4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" target="d_sync" value="optional trigger: owners changed&amp;nbsp;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_why" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;What moves, what stays&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Moves:&lt;/b&gt; swarm members and the owning teams of a service, both in Port. GitHub team membership follows.&lt;br&gt;&lt;br&gt;&lt;b&gt;Stays:&lt;/b&gt; repo names, GitHub team names and CODEOWNERS.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why it matters:&lt;/b&gt; teams can form and dissolve each quarter without pull requests or manual GitHub changes.&lt;br&gt;&lt;br&gt;A service can have several owning swarms, and a swarm can own several services." vertex="1">
          <mxGeometry height="270" width="260" x="1520" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;br&gt;Green: configured for this solution&lt;br&gt;Blue: existing Port or GitHub object&lt;br&gt;Gray: static, never edited&lt;br&gt;Dashed arrow: optional trigger" vertex="1">
          <mxGeometry height="215" width="260" x="1520" y="600" as="geometry" />
        </mxCell>
        <mxCell id="d_consult" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Where ownership is consulted (Port pages)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Org structure:&lt;/b&gt; teams by type, members, services owned&lt;br&gt;&lt;b&gt;My team:&lt;/b&gt; filtered to the viewer&#39;s own team&lt;br&gt;&lt;b&gt;Management:&lt;/b&gt; gaps (services with no owner, people in no team, stuck links, stuck adds)&lt;br&gt;&lt;b&gt;History:&lt;/b&gt; Ownership trail dashboard, fed by the ownership_change log" vertex="1">
          <mxGeometry height="200" width="260" x="1520" y="380" as="geometry" />
        </mxCell>
        <mxCell id="d_ex_lbl" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#333333;fontStyle=1;" value="WORKED EXAMPLE: a new Payments swarm gets access to payments-api" vertex="1">
          <mxGeometry height="22" width="900" x="20" y="875" as="geometry" />
        </mxCell>
        <mxCell id="d_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;1. Create the swarm&lt;/b&gt;&lt;br&gt;Payments swarm 2027Q1, parent: Payments" vertex="1">
          <mxGeometry height="95" width="270" x="20" y="905" as="geometry" />
        </mxCell>
        <mxCell id="d_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;2. Add members&lt;/b&gt;&lt;br&gt;Run add_user_to_swarm in the Port UI for each member" vertex="1">
          <mxGeometry height="95" width="270" x="320" y="905" as="geometry" />
        </mxCell>
        <mxCell id="d_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;3. Link to the service&lt;/b&gt;&lt;br&gt;Run add_swarm_to_service for payments_api and the swarm" vertex="1">
          <mxGeometry height="95" width="270" x="620" y="905" as="geometry" />
        </mxCell>
        <mxCell id="d_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;4. Owners update&lt;/b&gt;&lt;br&gt;The swarm and its parent are added to payments_api owners; existing owners stay" vertex="1">
          <mxGeometry height="95" width="270" x="920" y="905" as="geometry" />
        </mxCell>
        <mxCell id="d_s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;5. GitHub follows&lt;/b&gt;&lt;br&gt;The swarm&#39;s members join owners-payments-api. CODEOWNERS is untouched" vertex="1">
          <mxGeometry height="95" width="270" x="1220" y="905" as="geometry" />
        </mxCell>
        <mxCell id="d_e_d_s1d_s2" edge="1" parent="1" source="d_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_s2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_d_s2d_s3" edge="1" parent="1" source="d_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_s3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_d_s3d_s4" edge="1" parent="1" source="d_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_s4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_d_s4d_s5" edge="1" parent="1" source="d_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" target="d_s5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 Data model" id="p2datamodel"><mxGraphModel dx="1884" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m_title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;fontStyle=1;" value="How the ownership model is built in Port: blueprints, properties and relations" vertex="1"><mxGeometry height="30" width="1460" x="20" y="10" as="geometry" /></mxCell><mxCell id="m_sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" value="Each box is a Port blueprint (a data type). Arrows are relations or ownership fields. This is everything the pattern adds to a Port organization. The workflows, pages and GitHub sync are all driven by this model." vertex="1"><mxGeometry height="36" width="1460" x="20" y="44" as="geometry" /></mxCell><mxCell id="m_user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;User&lt;/b&gt; (_user)&lt;br&gt;&lt;i&gt;Built in to Port, extended&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;github_login: string &lt;i&gt;(added)&lt;/i&gt;&lt;br&gt;pending_swarm: string, staging &lt;i&gt;(added)&lt;/i&gt;&lt;br&gt;port_role: enum Admin | Admin Readonly | Moderator | Member&lt;br&gt;port_type, status, moderated_blueprints &lt;i&gt;(built in)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ownership field&lt;/b&gt;&lt;br&gt;Teams: list of the teams the user belongs to (persistent teams and swarms)" vertex="1"><mxGeometry height="270" width="360" x="20" y="140" as="geometry" /></mxCell><mxCell id="m_team" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Team&lt;/b&gt; (_team)&lt;br&gt;&lt;i&gt;Built in to Port, extended&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;team_kind: enum swarm | long_lived&lt;br&gt;type: enum team | group&lt;br&gt;status: enum planned | active | retired&lt;br&gt;period: string, e.g. 2026Q4&lt;br&gt;start_date, end_date: string&lt;br&gt;description: string&lt;br&gt;&lt;br&gt;&lt;b&gt;Relation&lt;/b&gt;&lt;br&gt;parent_team &amp;rarr; Team (single, optional)&lt;br&gt;&lt;br&gt;&lt;b&gt;Mirror property&lt;/b&gt;&lt;br&gt;parent_team_name = parent_team.$title&lt;br&gt;&lt;br&gt;&lt;b&gt;Aggregation property&lt;/b&gt;&lt;br&gt;size = count of Users in the team" vertex="1"><mxGeometry height="340" width="380" x="520" y="140" as="geometry" /></mxCell><mxCell id="m_svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Service&lt;/b&gt; (service)&lt;br&gt;&lt;i&gt;Your existing service blueprint, extended&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;Your existing properties stay as they are&lt;br&gt;&lt;br&gt;&lt;b&gt;Relations&lt;/b&gt;&lt;br&gt;pending_swarm &amp;rarr; Team (single, staging)&lt;br&gt;github_repository &amp;rarr; GitHub Repository (optional, if you use the GitHub integration)&lt;br&gt;&lt;br&gt;&lt;b&gt;Mirror property&lt;/b&gt;&lt;br&gt;pending_swarm_parent = pending_swarm.parent_team.$identifier&lt;br&gt;&lt;br&gt;&lt;b&gt;Ownership field&lt;/b&gt;&lt;br&gt;Owning teams: list of teams (Direct ownership)" vertex="1"><mxGeometry height="360" width="380" x="1080" y="140" as="geometry" /></mxCell><mxCell id="m_ght" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;GitHub Team&lt;/b&gt; (githubTeam)&lt;br&gt;&lt;i&gt;Optional, from the GitHub integration&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;slug, description, link, notification_setting&lt;br&gt;&lt;br&gt;One team per repo, named owners-&amp;lt;repo&amp;gt;. Its members are the only thing that changes in GitHub." vertex="1"><mxGeometry height="170" width="360" x="20" y="570" as="geometry" /></mxCell><mxCell id="m_repo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;GitHub Repository&lt;/b&gt; (githubRepository)&lt;br&gt;&lt;i&gt;Optional, from the GitHub integration&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;url, defaultBranch, visibility, language, last_push&lt;br&gt;codeowners, readme: markdown (CODEOWNERS stays static)&lt;br&gt;&lt;br&gt;&lt;b&gt;Relation&lt;/b&gt;&lt;br&gt;githubTeams &amp;rarr; GitHub Team (many)" vertex="1"><mxGeometry height="210" width="380" x="1080" y="570" as="geometry" /></mxCell><mxCell id="m_oc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Ownership Change&lt;/b&gt; (ownership_change)&lt;br&gt;&lt;i&gt;Added by the pattern, the history log&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;entity: string, identifier of the service, team or user&lt;br&gt;entity_type: enum service | team | user&lt;br&gt;change_type: enum owning_team | membership | parent_team&lt;br&gt;before, after: string, the team lists&lt;br&gt;changed_by: string&lt;br&gt;changed_at: date-time&lt;br&gt;source: enum ui | action | workflow&lt;br&gt;approved_by: string, self_approved: boolean&lt;br&gt;reason: string&lt;br&gt;&lt;br&gt;No relations. One row per change, written by the logging workflows." vertex="1"><mxGeometry height="330" width="360" x="20" y="800" as="geometry" /></mxCell><mxCell id="m_key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Key modeling choices&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Ownership is a built-in list field, not a relation.&lt;/b&gt; Service owning teams and User teams both point at Team.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. A swarm is a Team with team_kind = swarm.&lt;/b&gt; Its single parent_team is the long-lived team that always co-owns the services the swarm owns.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Staging fields&lt;/b&gt; (User.pending_swarm, Service.pending_swarm) pass a form to an event workflow. The workflow applies the change and clears the field, so owners are appended and never overwritten.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. The mirror pending_swarm_parent&lt;/b&gt; lets the workflow find the parent team without anyone typing it.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Ownership Change&lt;/b&gt; keeps a durable history of who owned what and when it changed.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. GitHub:&lt;/b&gt; CODEOWNERS never changes. ownership-sync fills owners-&amp;lt;repo&amp;gt; from User.github_login." vertex="1"><mxGeometry height="410" width="380" x="520" y="720" as="geometry" /></mxCell><mxCell id="m_leg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Blue:&lt;/b&gt; existing blueprint, extended by the pattern&lt;br&gt;&lt;b&gt;Green:&lt;/b&gt; blueprint added by the pattern&lt;br&gt;&lt;b&gt;Gray:&lt;/b&gt; optional, from the GitHub integration&lt;br&gt;&lt;br&gt;&lt;b&gt;Solid arrow:&lt;/b&gt; relation or ownership field&lt;br&gt;&lt;b&gt;Dashed arrow:&lt;/b&gt; staging relation, or synced by ownership-sync&lt;br&gt;&lt;br&gt;&lt;i&gt;added&lt;/i&gt; = property added by the pattern to a built-in blueprint" vertex="1"><mxGeometry height="210" width="380" x="1080" y="830" as="geometry" /></mxCell><mxCell id="m_e_member" edge="1" parent="1" source="m_user" target="m_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2778;entryX=0;entryY=0.2206;" value="member of (many)&lt;br&gt;User.Teams field"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_e_owned" edge="1" parent="1" source="m_svc" target="m_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2083;entryX=1;entryY=0.2206;" value="owned by (many)&lt;br&gt;Service.Owning teams"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_e_pend" edge="1" parent="1" source="m_svc" target="m_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5278;entryX=1;entryY=0.5588;dashed=1;" value="pending_swarm&lt;br&gt;(single, staging)"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_e_parent" edge="1" parent="1" source="m_team" target="m_team" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" value="parent_team (single)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="108" /><mxPoint x="805" y="108" /></Array></mxGeometry></mxCell><mxCell id="m_e_repo" edge="1" parent="1" source="m_svc" target="m_repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="github_repository (optional)"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_e_ght" edge="1" parent="1" source="m_repo" target="m_ght" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.381;entryX=1;entryY=0.4706;" value="githubTeams (many)"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m_e_sync" edge="1" parent="1" source="m_user" target="m_ght" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" value="ownership-sync: github_login&lt;br&gt;decides the team members"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
</mxfile>
