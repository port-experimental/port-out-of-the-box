{
  "identifier": "apply_pending_owner",
  "title": "Apply pending swarm to service owners",
  "allowAnyoneToViewRuns": true,
  "nodes": [
    {
      "identifier": "trigger",
      "title": "Service has a pending swarm",
      "config": {
        "type": "EVENT_TRIGGER",
        "event": {
          "type": "ENTITY_UPDATED",
          "blueprintIdentifier": "__SERVICE_BLUEPRINT__"
        },
        "condition": {
          "type": "JQ",
          "expressions": [
            ".diff.after.relations.pending_swarm != null and .diff.after.relations.pending_swarm != \"\""
          ],
          "combinator": "and"
        },
        "published": true
      }
    },
    {
      "identifier": "add_swarm_and_parent_to_owners",
      "title": "Add swarm and its parent to owners, clear pending",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "__SERVICE_BLUEPRINT__",
        "mapping": {
          "identifier": "{{ .outputs.trigger.diff.after.identifier }}",
          "team": "{{ ([.outputs.trigger.diff.after.team, [.outputs.trigger.diff.after.relations.pending_swarm], [(.outputs.trigger.diff.after.properties.pending_swarm_parent // .outputs.trigger.diff.after.mirrorProperties.pending_swarm_parent)]] | flatten | map(select(. != null and . != \"\")) | unique) }}",
          "relations": {
            "pending_swarm": null
          }
        },
        "onFailure": "terminate",
        "timeoutMinutes": 60
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "add_swarm_and_parent_to_owners"
    }
  ],
  "description": "Appends the staged swarm and its parent team to the service owners, keeps existing owners, and clears the staging relation."
}
