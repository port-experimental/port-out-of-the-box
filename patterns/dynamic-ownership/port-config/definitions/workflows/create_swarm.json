{
  "identifier": "create_swarm",
  "title": "Create swarm",
  "allowAnyoneToViewRuns": true,
  "nodes": [
    {
      "identifier": "trigger",
      "title": "Create a Swarm",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "period": {
              "title": "Period",
              "type": "string"
            },
            "swarm_name": {
              "title": "Swarm name",
              "type": "string"
            },
            "description": {
              "title": "Description",
              "type": "string"
            },
            "parent_team": {
              "title": "Parent team",
              "type": "string",
              "format": "entity",
              "blueprint": "_team"
            }
          },
          "required": [
            "swarm_name",
            "period",
            "parent_team"
          ],
          "order": [
            "swarm_name",
            "period",
            "parent_team",
            "description"
          ]
        },
        "published": true,
        "permissions": {
          "roles": [
            "Admin"
          ],
          "teams": []
        }
      }
    },
    {
      "identifier": "upsert_entity_16460ee06e7d4641",
      "title": "Create swarm team",
      "config": {
        "type": "UPSERT_ENTITY",
        "blueprintIdentifier": "_team",
        "mapping": {
          "identifier": "swarm-{{ .outputs.trigger.swarm_name | ascii_downcase | gsub(\"[^a-z0-9]+\"; \"-\") }}-{{ .outputs.trigger.period | ascii_downcase }}",
          "title": "{{ .outputs.trigger.swarm_name }} swarm {{ .outputs.trigger.period }}",
          "properties": {
            "type": "team",
            "period": "{{ .outputs.trigger.period }}",
            "status": "planned",
            "team_kind": "swarm"
          },
          "relations": {
            "parent_team": "{{ .outputs.trigger.parent_team }}"
          }
        },
        "onFailure": "terminate",
        "timeoutMinutes": 60
      }
    }
  ],
  "connections": [
    {
      "sourceIdentifier": "trigger",
      "targetIdentifier": "upsert_entity_16460ee06e7d4641"
    }
  ],
  "description": "Creates a swarm: a temporary team under a long-lived parent team."
}
